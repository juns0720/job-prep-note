# 이 파일을 .env.local 로 복사해서 채운다. .env.local 은 커밋되지 않는다.
#   cp .env.local.example .env.local
# 값을 바꾼 뒤에는 npm run dev 를 껐다 다시 켠다(환경 변수는 서버를 켤 때 읽는다).

# ── 필수 ── Supabase 대시보드에서 복사한다(README 5단계).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 공고 수집기·재료 내보내기를 쓸 때 ── 앱에 로그인하는 이메일·비밀번호다.
# 웹에는 나가지 않고 이 컴퓨터의 스크립트(scripts/import.mjs, export-materials.mjs)만 쓴다.
# 비워두면 스크립트가 돌 때 터미널에서 묻는다.
STUDY_NOTE_EMAIL=
STUDY_NOTE_PASSWORD=

# ── 선택 ── 잡플래닛에서 회사 평점·연봉을 가져올 때만 쓴다(scripts/enrich.mjs).
# 잡플래닛은 스크립트 요청을 403으로 막아서, 브라우저에서 쓰던 쿠키가 있어야 한다.
# 꺼내는 법은 docs/job-collector.md 4단계. 비워두면 그 단계만 건너뛴다.
# JOBPLANET_COOKIE=
