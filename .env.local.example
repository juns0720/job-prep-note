# 이 파일을 .env.local로 복사한 뒤 값을 채운다. .env.local은 커밋 대상에서 제외되어 있다.
#   cp .env.local.example .env.local
# 값을 바꾼 뒤에는 스크립트를 다시 실행한다.

# 필수: Supabase 대시보드에서 복사한다(README 5단계).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 공고 수집, 데이터 가져오기와 내보내기에 사용하는 앱 로그인 이메일과 비밀번호.
# scripts/의 로컬 스크립트에서만 사용한다.
# 비워 두면 스크립트 실행 시 터미널에서 입력을 요청한다.
STUDY_NOTE_EMAIL=
STUDY_NOTE_PASSWORD=

# 선택: 잡플래닛의 회사 평점과 연봉 수집에 사용한다(scripts/enrich.mjs).
# 스크립트 요청이 403 오류로 차단되면 브라우저 쿠키가 필요하다.
# 필요한 경우 AI에게 잡플래닛 연결 설정을 요청한다. 비워 두면 회사 평판 수집만 건너뛴다.
# JOBPLANET_COOKIE=
